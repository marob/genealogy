// Database schema of the genealogy application.
// Genealogy data (Person, Family, Event, Place) is entirely replaced on each
// GEDCOM import; the public identifiers of persons and families are the GEDCOM
// references (e.g. "I123", "F45") so that URLs remain stable from one import
// to the next.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Genealogy
// ---------------------------------------------------------------------------

model Person {
  /// GEDCOM reference without the @ (e.g. "I123").
  id                 String  @id
  givenNames         String  @default("")
  surname            String  @default("")
  /// "M", "F" or "U" (unknown).
  sex                String  @default("U")
  occupation         String?
  note               String?
  /// Normalized full name (lowercase, no accents) for search.
  searchName         String  @default("")
  /// Normalized "surname given-names", for accent-insensitive alphabetical sorting.
  sortName           String  @default("")
  /// Known or estimated YYYYMMDD birth date (from parents, children,
  /// unions...), unknown parts filled with the latest value. Used by the
  /// under-100-years privacy rule; null = unknown (contemporary).
  birthKey           Int?
  /// true if birthKey is estimated rather than taken from a dated birth.
  birthKeyEstimated  Boolean @default(false)

  events        Event[]
  media         Media[]
  childOf       FamilyChild[]
  asPartner1    Family[]      @relation("partner1")
  asPartner2    Family[]      @relation("partner2")

  @@index([searchName])
  @@index([sortName])
  @@index([surname])
  @@index([birthKey])
}

model Family {
  /// GEDCOM reference without the @ (e.g. "F45").
  id         String  @id
  partner1Id String?
  partner2Id String?

  partner1 Person?       @relation("partner1", fields: [partner1Id], references: [id], onDelete: SetNull)
  partner2 Person?       @relation("partner2", fields: [partner2Id], references: [id], onDelete: SetNull)
  children FamilyChild[]
  events   Event[]
  media    Media[]

  @@index([partner1Id])
  @@index([partner2Id])
}

model FamilyChild {
  familyId String
  childId  String
  /// Order of the child in the family (GEDCOM file order).
  position Int    @default(0)
  /// GEDCOM pedigree link (PEDI): birth, adopted, foster...
  pedigree String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Person @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([familyId, childId])
  @@index([childId])
}

model Event {
  id          Int     @id @default(autoincrement())
  /// GEDCOM tag: BIRT, CHR, BAPM, DEAT, BURI, MARR, DIV, OCCU...
  type        String
  personId    String?
  familyId    String?
  /// Value or free-text description (e.g. occupation title).
  value       String?

  // Structured date: never converted to a JS Date to avoid any
  // time zone shift.
  dateOriginal  String?
  /// exact, about, calculated, estimated, before, after, between, from, to, from-to, phrase
  dateQualifier String?
  dateCalendar  String?
  dateYear      Int?
  dateMonth     Int?
  dateDay       Int?
  dateEndYear   Int?
  dateEndMonth  Int?
  dateEndDay    Int?
  /// Gregorian YYYYMMDD sort key (00 for unknown parts).
  dateSortKey   Int?
  /// Gregorian YYYYMMDD key of the second bound (between, from-to).
  dateEndSortKey Int?

  placeId Int?

  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  place  Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([familyId])
  @@index([type, dateSortKey])
  @@index([placeId])
}

model Place {
  id          Int     @id @default(autoincrement())
  /// Full label as it appears in the GEDCOM.
  fullName    String  @unique
  locality    String?
  postalCode  String?
  county      String?
  region      String?
  country     String?
  latitude    Float?
  longitude   Float?
  /// Normalized label for search.
  searchName  String  @default("")

  events Event[]

  @@index([searchName])
}

/// Document (photo, scanned record…) of a person or a family, replaced on each import.
model Media {
  id        Int     @id @default(autoincrement())
  personId  String?
  familyId  String?
  /// Related event (BIRT, MARR…), if any.
  eventType String?
  title     String?
  /// File name as given in the GEDCOM file.
  fileName  String
  /// Stored file (null when the file was not provided with the import).
  hash      String?
  /// Order within the person or family (GEDCOM file order).
  position  Int     @default(0)

  person Person?    @relation(fields: [personId], references: [id], onDelete: Cascade)
  family Family?    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  file   MediaFile? @relation(fields: [hash], references: [hash])

  @@index([personId])
  @@index([familyId])
  @@index([hash])
}

/// File stored on disk (MEDIA_DIR), named after the SHA-256 of its content.
model MediaFile {
  hash      String   @id
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  media   Media[]
  imports ImportFile[]
}

/// Documents provided with an import, by file name, to be linked on commit.
model ImportFile {
  importId Int
  /// Lowercase file name (see mediaKey).
  key      String
  fileName String
  hash     String

  importRun ImportRun @relation(fields: [importId], references: [id], onDelete: Cascade)
  file      MediaFile @relation(fields: [hash], references: [hash])

  @@id([importId, key])
  @@index([hash])
}

model ImportRun {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  committedAt    DateTime?
  /// preview, committed, failed, discarded
  status         String
  fileName       String
  encoding       String
  gedcomVersion  String?
  sourceSoftware String?
  /// Statistics and warnings serialized as JSON.
  stats          String    @default("{}")
  warnings       String    @default("[]")
  /// Original GEDCOM file, kept so it can be re-applied.
  content        Bytes
  /// false to leave the notes of the file out of the tree.
  importNotes    Boolean   @default(true)
  userId         Int?

  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  files ImportFile[]
}

// ---------------------------------------------------------------------------
// Users and settings
// ---------------------------------------------------------------------------

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  displayName        String?
  avatarUrl          String?
  /// ADMIN or MEMBER.
  role               String    @default("MEMBER")
  /// Permission to view the details of persons born less than 100 years ago.
  canSeeContemporary Boolean   @default(false)
  /// Personal root of the tree (GEDCOM reference, no foreign key because
  /// persons are recreated on each import; ignored if it no longer exists).
  rootPersonId       String?
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?

  identities Identity[]
  imports    ImportRun[]
}

model Identity {
  id       Int    @id @default(autoincrement())
  /// OIDC / OAuth2 provider: google, facebook...
  provider String
  /// User identifier at the provider ("sub").
  subject  String
  userId   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
}

model Setting {
  key   String @id
  value String
}
