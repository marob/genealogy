# Copy to .env for local development.
DATABASE_URL="file:../data/genealogie.db"
PORT=3000
# Public URL of the application (used for OIDC callbacks and cookies).
PUBLIC_URL="http://localhost:4200"
# Session cookie signing secret (32 characters minimum).
# Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Emails (comma-separated) promoted to admin on their first login.
ADMIN_EMAILS=""
# Development mode: every visitor is treated as an admin.
# Rejected at startup if PUBLIC_URL does not point to localhost.
AUTH_DEV_BYPASS=false
# Log format: json or pretty.
LOG_FORMAT=pretty
# Reference time zone for the 100-year rule.
APP_TIMEZONE="Europe/Paris"
# Identity providers (leave empty to disable).
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com/apps
#   Redirect URI: ${PUBLIC_URL}/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Generic OpenID Connect provider (e.g. Keycloak, Microsoft Entra, Authelia).
#   Redirect URI: ${PUBLIC_URL}/api/auth/${OIDC_NAME}/callback
OIDC_NAME=""
OIDC_LABEL=""
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
