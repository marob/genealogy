# Copier en .env pour le développement local.
DATABASE_URL="file:../data/genealogie.db"
PORT=3000
# URL publique de l'application (utilisée pour les callbacks OIDC et les cookies).
PUBLIC_URL="http://localhost:4200"
# Secret de signature des cookies de session (32 caractères minimum).
SESSION_SECRET="change-me-change-me-change-me-change-me"
# E-mails (séparés par des virgules) promus admin à leur première connexion.
ADMIN_EMAILS=""
# Mode développement : tout visiteur est considéré comme admin.
# Refusé au démarrage si PUBLIC_URL ne pointe pas vers localhost.
AUTH_DEV_BYPASS=false
# Format des journaux : json ou pretty.
LOG_FORMAT=pretty
# Fuseau horaire de référence pour la règle des 100 ans.
APP_TIMEZONE="Europe/Paris"
# Fournisseurs d'identité (laisser vide pour désactiver).
# Google : https://console.cloud.google.com/apis/credentials
#   URI de redirection : ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook : https://developers.facebook.com/apps
#   URI de redirection : ${PUBLIC_URL}/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Fournisseur OpenID Connect générique (ex. Keycloak, Microsoft Entra, Authelia).
#   URI de redirection : ${PUBLIC_URL}/api/auth/${OIDC_NAME}/callback
OIDC_NAME=""
OIDC_LABEL=""
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
