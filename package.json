{
  "name": "genealogie",
  "version": "0.1.0",
  "private": true,
  "description": "Family tree visualization and sharing, with GEDCOM import.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm start -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w shared -w backend -w frontend",
    "test:cov": "npm run test:cov -w shared -w backend -w frontend",
    "test:e2e": "npm run build && npm test -w e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
