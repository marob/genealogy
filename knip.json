{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "backend": {
      "entry": ["src/main.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "!src/generated/**"],
      "ignoreDependencies": ["@prisma/client", "pino-pretty"]
    },
    "frontend": {
      "entry": ["src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "e2e": {
      "entry": ["tests/**/*.ts"],
      "ignoreBinaries": ["prisma"]
    }
  }
}
