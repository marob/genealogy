FACEBOOK_CLIENT_SECRET=
OIDC_NAME=
OIDC_LABEL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TRUST_EMAIL=false
